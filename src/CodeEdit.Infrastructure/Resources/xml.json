{
  "languageId": "xml",
  "displayName": "XML",
  "extensions": [ ".xml", ".csproj", ".props", ".targets", ".config", ".xaml", ".resx" ],
  "shebangs": [],
  "rules": [
    { "type": "block",   "open": "<!--",          "close": "-->",      "token": "Comment"       },
    { "type": "block",   "open": "<!\\[CDATA\\[", "close": "\\]\\]>",  "token": "StringLiteral" },
    { "type": "block",   "open": "<\\?",          "close": "\\?>",     "token": "Keyword"       },
    { "type": "span",    "open": "\"",            "close": "\"",       "multiLine": false, "token": "StringLiteral" },
    { "type": "span",    "open": "'",             "close": "'",        "multiLine": false, "token": "StringLiteral" },
    { "type": "pattern", "pattern": "</|/>|[<>=]",                                         "token": "Punctuation"   },
    { "type": "pattern", "pattern": "[a-zA-Z_][a-zA-Z0-9:._-]*",                          "token": "Identifier"    }
  ]
}
