{
  "languageId": "json",
  "displayName": "JSON",
  "extensions": [ ".json" ],
  "shebangs": [],
  "rules": [
    { "type": "span",    "open": "\"",  "close": "\"",  "escape": "\\\\", "multiLine": false, "token": "StringLiteral" },
    { "type": "keywords", "words": [ "true", "false", "null" ], "token": "Keyword" },
    { "type": "pattern", "pattern": "-?\\b[0-9]+(\\.[0-9]+)?([eE][+\\-]?[0-9]+)?\\b", "token": "Number"      },
    { "type": "pattern", "pattern": "[{}\\[\\]:,]",                                    "token": "Punctuation" }
  ]
}
